# OpenAI-compatible API (OpenRouter recommended for free models)
# Get a key at https://openrouter.ai/keys — do NOT invent keys.
OPENAI_API_KEY=sk-or-v1-your-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Default free chat model (OpenRouter). Availability can change; pick another :free model if needed.
# See https://openrouter.ai/models?q=free
MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional GitHub token for github tools (gh CLI / API)
GITHUB_TOKEN=

# Server
HOST=0.0.0.0
PORT=8080

# Agent limits
MAX_TOOL_ROUNDS=15
SHELL_TIMEOUT_SECONDS=60

# Workspace path inside agent container (do not change unless you know why)
WORKSPACE_DIR=/app/workspace

# --- Phase 2: interactive desktop ---
# WARNING: empty password + VNC_NO_PASSWORD=1 means anyone who can reach noVNC
# can control the desktop. Fine for a quick tryout; lock down for production
# (set a password, firewall, or put TLS+auth in front).
VNC_PASSWORD=
VNC_NO_PASSWORD=1

# Optional direct :6080 URL (legacy / fullscreen). The chat UI embeds same-origin
# /novnc/ on port 8080 so mobile carriers that block 6080 still work.
NOVNC_PUBLIC_URL=http://localhost:6080

# Agent → desktop-api (Docker DNS hostname). Leave as-is in Compose.
DESKTOP_API_URL=http://desktop:7090
# Agent → noVNC upstream for /novnc/ reverse proxy. Leave as-is in Compose.
NOVNC_UPSTREAM=http://desktop:6080

# Optional desktop resolution
# SCREEN_WIDTH=1280
# SCREEN_HEIGHT=800
