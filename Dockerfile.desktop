# Interactive Linux desktop for Nitc Agent — polished lean XFCE + Chromium + noVNC
# Dark wallpaper, Greybird-dark + Papirus-Dark, bottom panel with Browser/Terminal/Files.
# Image ~1.5–2GB; fine on a 4GB VPS with mem_limit ~1g and shm_size 256mb.
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    DISPLAY=:99 \
    HOME=/home/desktop \
    DESKTOP_WORKSPACE=/home/desktop/workspace \
    LANG=C.UTF-8 \
    XDG_CONFIG_HOME=/home/desktop/.config \
    XDG_DATA_HOME=/home/desktop/.local/share \
    XDG_CACHE_HOME=/home/desktop/.cache

RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11-utils \
    x11-xserver-utils \
    # Lean XFCE
    xfce4-session \
    xfce4-panel \
    xfce4-settings \
    xfdesktop4 \
    xfwm4 \
    xfce4-terminal \
    thunar \
    dbus-x11 \
    xfce4-whiskermenu-plugin \
    xfce4-appfinder \
    # Theme / icons (readable, modern)
    greybird-gtk-theme \
    papirus-icon-theme \
    # Input / capture
    xdotool \
    xclip \
    xsel \
    scrot \
    imagemagick \
    # VNC + noVNC
    x11vnc \
    novnc \
    websockify \
    # Browser
    chromium \
    # Fonts / basics
    fonts-liberation \
    fonts-dejavu-core \
    fonts-noto-color-emoji \
    ca-certificates \
    curl \
    python3 \
    python3-pip \
    python3-venv \
    procps \
    libglib2.0-bin \
    shared-mime-info \
    librsvg2-common \
    hsetroot \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/chromium /usr/local/bin/chromium-browser || true \
    && update-alternatives --set x-terminal-emulator /usr/bin/xfce4-terminal.wrapper 2>/dev/null || true

RUN useradd -m -u 1000 -s /bin/bash desktop \
    && mkdir -p \
      /home/desktop/workspace/screenshots \
      /home/desktop/.vnc \
      /home/desktop/Desktop \
      /home/desktop/.config/autostart \
      /home/desktop/.config/xfce4/panel \
      /home/desktop/.config/xfce4/xfconf/xfce-perchannel-xml \
      /home/desktop/.local/share/applications \
      /opt/desktop-api \
      /opt/nitc-wallpaper \
    && chown -R desktop:desktop /home/desktop

# Soft modern wallpaper (baked asset — not solid black)
COPY desktop/assets/wallpaper.png /opt/nitc-wallpaper/wallpaper.png

# Desktop icons
COPY desktop/xfce-config/launchers/browser.desktop /home/desktop/Desktop/Browser.desktop
COPY desktop/xfce-config/launchers/terminal.desktop /home/desktop/Desktop/Terminal.desktop
COPY desktop/xfce-config/launchers/files.desktop /home/desktop/Desktop/Files.desktop
RUN chmod +x /home/desktop/Desktop/*.desktop \
    && chown -R desktop:desktop /home/desktop/Desktop

# Also install into applications menu
RUN cp /home/desktop/Desktop/Browser.desktop /home/desktop/.local/share/applications/nitc-browser.desktop \
    && cp /home/desktop/Desktop/Terminal.desktop /home/desktop/.local/share/applications/nitc-terminal.desktop \
    && cp /home/desktop/Desktop/Files.desktop /home/desktop/.local/share/applications/nitc-files.desktop \
    && chown -R desktop:desktop /home/desktop/.local

# XFCE channel configs (theme, panel, wallpaper, wm)
COPY desktop/xfce-config/xfce4-desktop.xml /home/desktop/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml
COPY desktop/xfce-config/xfce4-panel.xml /home/desktop/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml
COPY desktop/xfce-config/xsettings.xml /home/desktop/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml
COPY desktop/xfce-config/xfwm4.xml /home/desktop/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml

# Panel launcher plugin item dirs (plugin-3/4/5)
RUN mkdir -p \
      /home/desktop/.config/xfce4/panel/launcher-3 \
      /home/desktop/.config/xfce4/panel/launcher-4 \
      /home/desktop/.config/xfce4/panel/launcher-5 \
    && cp /home/desktop/Desktop/Browser.desktop /home/desktop/.config/xfce4/panel/launcher-3/browser.desktop \
    && cp /home/desktop/Desktop/Terminal.desktop /home/desktop/.config/xfce4/panel/launcher-4/terminal.desktop \
    && cp /home/desktop/Desktop/Files.desktop /home/desktop/.config/xfce4/panel/launcher-5/files.desktop

RUN printf '%s\n' \
  '<?xml version="1.0" encoding="UTF-8"?>' \
  '<channel name="xfce4-session" version="1.0">' \
  '  <property name="general" type="empty">' \
  '    <property name="SaveOnExit" type="bool" value="false"/>' \
  '    <property name="PromptOnLogout" type="bool" value="false"/>' \
  '  </property>' \
  '</channel>' \
  > /home/desktop/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-session.xml \
  && chown -R desktop:desktop /home/desktop/.config

# Desktop control API
COPY desktop/api/requirements.txt /opt/desktop-api/requirements.txt
RUN pip3 install --break-system-packages --no-cache-dir -r /opt/desktop-api/requirements.txt
COPY desktop/api/main.py /opt/desktop-api/main.py
COPY desktop/entrypoint.sh /usr/local/bin/desktop-entrypoint.sh
RUN chmod +x /usr/local/bin/desktop-entrypoint.sh \
    && chown -R desktop:desktop /opt/desktop-api /opt/nitc-wallpaper

USER desktop
WORKDIR /home/desktop

EXPOSE 6080 7090

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -fsS http://127.0.0.1:7090/health || exit 1

CMD ["/usr/local/bin/desktop-entrypoint.sh"]
