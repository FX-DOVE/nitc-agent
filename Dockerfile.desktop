# Interactive Linux desktop for Nitc Agent — lean XFCE + Chromium + noVNC
# Heavier than openbox (~800MB–1.2GB image) but shows a real desktop with
# panel, wallpaper, and icons. Reasonable on a 4GB VPS with shm_size 256mb;
# leave headroom for the agent container.
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    DISPLAY=:99 \
    HOME=/home/desktop \
    DESKTOP_WORKSPACE=/home/desktop/workspace \
    LANG=C.UTF-8 \
    XDG_CONFIG_HOME=/home/desktop/.config \
    XDG_DATA_HOME=/home/desktop/.local/share \
    XDG_CACHE_HOME=/home/desktop/.cache

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Display server
    xvfb \
    x11-utils \
    x11-xserver-utils \
    # Lean XFCE (avoid full xfce4 meta — pulls extras)
    xfce4-session \
    xfce4-panel \
    xfce4-settings \
    xfdesktop4 \
    xfwm4 \
    xfce4-terminal \
    thunar \
    dbus-x11 \
    # Panel plugins (lightweight)
    xfce4-whiskermenu-plugin \
    # Input / capture
    xdotool \
    scrot \
    imagemagick \
    # VNC + noVNC
    x11vnc \
    novnc \
    websockify \
    # Browser + file tools
    chromium \
    # Fonts / basics
    fonts-liberation \
    fonts-dejavu-core \
    fonts-noto-color-emoji \
    ca-certificates \
    curl \
    python3 \
    python3-pip \
    python3-venv \
    procps \
    # Solid wallpaper helper
    hsetroot \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/chromium /usr/local/bin/chromium-browser || true \
    && update-alternatives --set x-terminal-emulator /usr/bin/xfce4-terminal.wrapper 2>/dev/null || true

# Desktop user
RUN useradd -m -u 1000 -s /bin/bash desktop \
    && mkdir -p \
      /home/desktop/workspace/screenshots \
      /home/desktop/.vnc \
      /home/desktop/Desktop \
      /home/desktop/.config/autostart \
      /home/desktop/.config/xfce4/xfconf/xfce-perchannel-xml \
      /home/desktop/.local/share/applications \
      /opt/desktop-api \
      /opt/nitc-wallpaper \
    && chown -R desktop:desktop /home/desktop

# Solid dark wallpaper PNG (ImageMagick; no external assets)
RUN convert -size 1920x1080 "gradient:#0e1624-#1a2a44" /opt/nitc-wallpaper/wallpaper.png \
    || convert -size 1920x1080 xc:#121c30 /opt/nitc-wallpaper/wallpaper.png \
    || true


# Desktop launchers (icons on Desktop)
RUN printf '%s\n' \
  '[Desktop Entry]' \
  'Version=1.0' \
  'Type=Application' \
  'Name=Browser' \
  'Comment=Chromium web browser' \
  'Exec=chromium --no-sandbox --disable-gpu --disable-dev-shm-usage' \
  'Icon=chromium' \
  'Terminal=false' \
  'Categories=Network;WebBrowser;' \
  > /home/desktop/Desktop/Browser.desktop \
  && printf '%s\n' \
  '[Desktop Entry]' \
  'Version=1.0' \
  'Type=Application' \
  'Name=Terminal' \
  'Comment=XFCE Terminal' \
  'Exec=xfce4-terminal' \
  'Icon=utilities-terminal' \
  'Terminal=false' \
  'Categories=System;TerminalEmulator;' \
  > /home/desktop/Desktop/Terminal.desktop \
  && printf '%s\n' \
  '[Desktop Entry]' \
  'Version=1.0' \
  'Type=Application' \
  'Name=Files' \
  'Comment=Thunar file manager' \
  'Exec=thunar /home/desktop/workspace' \
  'Icon=system-file-manager' \
  'Terminal=false' \
  'Categories=System;FileManager;' \
  > /home/desktop/Desktop/Files.desktop \
  && chmod +x /home/desktop/Desktop/*.desktop \
  && chown -R desktop:desktop /home/desktop/Desktop

# xfdesktop: show icons + wallpaper
RUN printf '%s\n' \
  '<?xml version="1.0" encoding="UTF-8"?>' \
  '<channel name="xfce4-desktop" version="1.0">' \
  '  <property name="backdrop" type="empty">' \
  '    <property name="screen0" type="empty">' \
  '      <property name="monitor0" type="empty">' \
  '        <property name="workspace0" type="empty">' \
  '          <property name="color-style" type="int" value="0"/>' \
  '          <property name="image-style" type="int" value="5"/>' \
  '          <property name="last-image" type="string" value="/opt/nitc-wallpaper/wallpaper.png"/>' \
  '        </property>' \
  '      </property>' \
  '      <property name="monitorVNC-0" type="empty">' \
  '        <property name="workspace0" type="empty">' \
  '          <property name="color-style" type="int" value="0"/>' \
  '          <property name="image-style" type="int" value="5"/>' \
  '          <property name="last-image" type="string" value="/opt/nitc-wallpaper/wallpaper.png"/>' \
  '        </property>' \
  '      </property>' \
  '    </property>' \
  '  </property>' \
  '  <property name="desktop-icons" type="empty">' \
  '    <property name="style" type="int" value="2"/>' \
  '    <property name="file-icons" type="empty">' \
  '      <property name="show-home" type="bool" value="false"/>' \
  '      <property name="show-filesystem" type="bool" value="false"/>' \
  '      <property name="show-trash" type="bool" value="false"/>' \
  '      <property name="show-removable" type="bool" value="false"/>' \
  '    </property>' \
  '  </property>' \
  '</channel>' \
  > /home/desktop/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml \
  && chown -R desktop:desktop /home/desktop/.config

# Disable first-run / session save prompts where possible
RUN printf '%s\n' \
  '<?xml version="1.0" encoding="UTF-8"?>' \
  '<channel name="xfce4-session" version="1.0">' \
  '  <property name="general" type="empty">' \
  '    <property name="SaveOnExit" type="bool" value="false"/>' \
  '    <property name="PromptOnLogout" type="bool" value="false"/>' \
  '  </property>' \
  '</channel>' \
  > /home/desktop/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-session.xml \
  && chown desktop:desktop /home/desktop/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-session.xml

# Desktop control API
COPY desktop/api/requirements.txt /opt/desktop-api/requirements.txt
RUN pip3 install --break-system-packages --no-cache-dir -r /opt/desktop-api/requirements.txt
COPY desktop/api/main.py /opt/desktop-api/main.py
COPY desktop/entrypoint.sh /usr/local/bin/desktop-entrypoint.sh
RUN chmod +x /usr/local/bin/desktop-entrypoint.sh \
    && chown -R desktop:desktop /opt/desktop-api /opt/nitc-wallpaper

USER desktop
WORKDIR /home/desktop

EXPOSE 6080 7090

HEALTHCHECK --interval=30s --timeout=5s --start-period=35s --retries=3 \
  CMD curl -fsS http://127.0.0.1:7090/health || exit 1

CMD ["/usr/local/bin/desktop-entrypoint.sh"]
