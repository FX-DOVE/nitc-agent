# OpenAI-compatible API (OpenAI, OpenRouter, local vLLM/Ollama, etc.)
OPENAI_API_KEY=sk-or-v1-your-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL=openai/gpt-4o-mini

# Optional GitHub token for github tools (gh CLI / API)
GITHUB_TOKEN=

# Server
HOST=0.0.0.0
PORT=8080

# Agent limits
MAX_TOOL_ROUNDS=15
SHELL_TIMEOUT_SECONDS=60

# Workspace path inside agent container (do not change unless you know why)
WORKSPACE_DIR=/app/workspace

# --- Phase 2: interactive desktop ---
# Password for noVNC / x11vnc (keep private; firewall port 6080 on VPS)
VNC_PASSWORD=nitc

# Public URL users open for noVNC (browser iframe + "Open fullscreen")
# Local: http://localhost:6080
# VPS:   http://YOUR_SERVER_IP:6080  or https://desktop.example.com
NOVNC_PUBLIC_URL=http://localhost:6080

# Agent → desktop-api (Docker DNS hostname). Leave as-is in Compose.
DESKTOP_API_URL=http://desktop:7090

# Optional desktop resolution
# SCREEN_WIDTH=1280
# SCREEN_HEIGHT=800
