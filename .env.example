# OpenAI-compatible API (OpenAI, OpenRouter, local vLLM/Ollama, etc.)
OPENAI_API_KEY=sk-or-v1-your-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL=openai/gpt-4o-mini

# Optional GitHub token for github tools (gh CLI / API)
GITHUB_TOKEN=

# Server
HOST=0.0.0.0
PORT=8080

# Agent limits
MAX_TOOL_ROUNDS=15
SHELL_TIMEOUT_SECONDS=60

# Workspace path inside container (do not change unless you know why)
WORKSPACE_DIR=/app/workspace
